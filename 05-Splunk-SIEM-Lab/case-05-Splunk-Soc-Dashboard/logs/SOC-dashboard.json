        "xAxisMajorTickSize": 7,
        "xAxisLineVisibility": "show"
      }
    },
    "viz_LYNp4Ozj": {
      "type": "splunk.table",
      "options": {
        "columnFormat": {
          "Source_Network_Address": {
            "width": 311
          },
          "Failed_Logons": {
            "width": 281
          }
        },
        "fontSize": "large",
        "tableFormat": {
          "headerAlign": "center",
          "align": "center",
          "rowBackgroundColors": "> table | gradient(tableFormatEditorConfig)"
        },
        "backgroundColor": "> themes.defaultBackgroundColor",
        "count": 11,
        "showRowNumbers": true
      },
      "dataSources": {
        "primary": "ds_DvygdYnt"
      },
      "title": "Failed Login Attempts By IP address",
      "containerOptions": {},
      "context": {
        "tableFormatEditorConfig": {
          "colors": [
            "#224468",
            "#0070F3"
          ]
        }
      }
    },
    "viz_SsbObmwG": {
      "type": "splunk.table",
      "options": {
        "tableFormat": {
          "headerAlign": "center",
          "align": "center",
          "rowBackgroundColors": "> table | gradient(tableFormatEditorConfig)"
        },
        "columnFormat": {
          "Failed_Logons": {
            "data": "> table | seriesByName(\"Failed_Logons\") | formatByType(Failed_LogonsColumnFormatEditorConfig)",
            "align": "auto",
            "headerAlign": "auto",
            "textOverflow": "break-word"
          }
        },
        "showRowNumbers": true
      },
      "dataSources": {
        "primary": "ds_aAP8Hx1D"
      },
      "context": {
        "Failed_LogonsColumnFormatEditorConfig": {
          "number": {
            "thousandSeparated": false,
            "unitPosition": "after"
          }
        },
        "tableFormatEditorConfig": {
          "colors": [
            "#224468",
            "#0070F3"
          ]
        }
      },
      "title": "Failed Login Attempts by Workstation Per User"
    }
  },
  "dataSources": {
    "ds_rqsfX8j1": {
      "type": "ds.search",
      "options": {
        "query": "index=\"winserver\" source=\"WinEventLog:Security\" host=\"WKSTN-041\" (EventCode=4625 OR EventCode=4624)\n| eval Logon_Status=if(EventCode=4624,\"Successful Logon\",\"Failed Logon\")\n| stats count by Logon_Status",
        "queryParameters": {
          "sampleRatio": "1"
        },
        "refresh": "5m",
        "refreshType": "delay",
        "enableSmartSources": true
      },
      "name": "WKSTN-041"
    },
    "ds_DvygdYnt": {
      "type": "ds.search",
      "options": {
        "query": "index=\"winserver\" source=\"WinEventLog:Security\" host=\"WKSTN-041\" EventCode=4625\n| stats count as Failed_Logons by Source_Network_Address\n| sort - Failed_Logons",
        "enableSmartSources": true,
        "refresh": "5m",
        "refreshType": "delay"
      },
      "name": "failed login by ip"
    },
    "ds_aAP8Hx1D": {
      "type": "ds.search",
      "options": {
        "query": "index=\"winserver\" source=\"WinEventLog:Security\" EventCode=4625\r\n| stats count as Failed_Logons by ComputerName, Account_Name\r\n| sort - Failed_Logons",
        "refresh": "5m",
        "refreshType": "delay",
        "enableSmartSources": true
      },
      "name": "Failed login attempts per workstation by usernames"
    }
  },
  "defaults": {
    "dataSources": {
      "ds.search": {
        "options": {
          "queryParameters": {
            "latest": "$global_time.latest$",
            "earliest": "$global_time.earliest$"
          }
        }
      },
      "ds.spl2": {
        "options": {
          "queryParameters": {
            "latest": "$global_time.latest$",
            "earliest": "$global_time.earliest$"
          }
        }
      }
    },
    "visualizations": {
      "global": {
        "showProgressBar": true
      }
    }
  },
